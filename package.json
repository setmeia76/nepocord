{
  "name": "nepocord",
  "version": "1.0.0",
  "description": "App de chat, voz e compartilhamento de tela para grupos de amigos",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"nodemon server.js\" \"cross-env ELECTRON_APP_URL=http://localhost:3000 electron .\"",
    "app": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "app.nepocord.desktop",
    "productName": "Nepocord",
    "files": [
      "main.js",
      "build/icone.png",
      "!node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icone.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icone.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icone.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
