{
  "name": "discord2",
  "version": "1.0.0",
  "description": "App de chat, voz e compartilhamento de tela para grupos de amigos",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.seunome.discord2",
    "productName": "discord2",
    "files": [
      "main.js",
      "build/icone.png",
      "!node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icone.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icone.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icone.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
