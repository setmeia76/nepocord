# Configuração de Porta do Servidor (Padrão: 3000)
PORT=3000

# Credenciais TURN Metered (Opcional - para conexões WebRTC em redes restritas)
# Crie uma conta gratuita em https://metered.ca se precisar de TURN relay
# METERED_API_KEY=sua_chave_aqui
# METERED_APP_NAME=seu_subdominio_aqui

# URL do App Desktop Electron (Opcional - padrão aponta para o Render em produção)
# Para desenvolvimento local, use: http://localhost:3000
# ELECTRON_APP_URL=http://localhost:3000
